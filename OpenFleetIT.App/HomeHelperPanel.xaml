<UserControl x:Class="OpenFleetIT.App.HomeHelperPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{DynamicResource HomeDevices}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource HomeDevicesSubtitle}" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,22"/>
            <Border Style="{StaticResource GlassCard}" Padding="22" Background="#71151925">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{DynamicResource PairADevice}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource PairingInstructions}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{DynamicResource HostnameOrIp}" Foreground="#8E98B1" Margin="0,0,0,7"/><TextBox x:Name="HostInput" Height="40" Padding="11,0" VerticalContentAlignment="Center" Background="#18FFFFFF" BorderBrush="#30FFFFFF" Foreground="White" CaretBrush="White"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource PairingCode}" Foreground="#8E98B1" Margin="0,0,0,7"/><TextBox x:Name="CodeInput" Height="40" MaxLength="6" Padding="11,0" VerticalContentAlignment="Center" Background="#18FFFFFF" BorderBrush="#30FFFFFF" Foreground="White" CaretBrush="White"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{DynamicResource ServerFingerprint}" Foreground="#8E98B1" Margin="0,0,0,7"/><TextBox x:Name="FingerprintInput" Height="40" MaxLength="95" Padding="11,0" VerticalContentAlignment="Center" Background="#18FFFFFF" BorderBrush="#30FFFFFF" Foreground="White" CaretBrush="White" FontFamily="Consolas"/></StackPanel>
                    <Border Grid.Row="3" Background="#18FFBC66" BorderBrush="#35FFBC66" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0"><TextBlock Text="{DynamicResource FingerprintWarning}" Foreground="#FFD08A" TextWrapping="Wrap"/></Border>
                    <Grid Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="StatusLabel" Text="{DynamicResource HomeNotConnected}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,310,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="VerifyButton" Content="{DynamicResource VerifyHelper}" Padding="16,9" Background="#20FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" Click="Verify_Click"/><Button x:Name="PairButton" Content="{DynamicResource PairDevice}" Padding="16,9" Margin="9,0,0,0" Background="#338B7CFF" Foreground="White" BorderBrush="#558B7CFF" Click="Pair_Click"/><Button x:Name="ConnectButton" Content="{DynamicResource ConnectPaired}" Padding="16,9" Margin="9,0,0,0" Background="#2257D7A3" Foreground="#8EF1C5" BorderBrush="#4057D7A3" Click="Connect_Click"/></StackPanel></Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
